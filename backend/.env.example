APP_NAME=Benka Workbench API
APP_ENV=development
SECRET_KEY=change-me-super-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# PostgreSQL (Docker / production)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/benka_workbench
# SQLite (no Docker, local dev only)
# DATABASE_URL=sqlite:///./benka.db
STORAGE_PATH=storage
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VITE_API_URL=http://127.0.0.1:8000